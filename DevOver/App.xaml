<Application x:Class="DevOver.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ایندکس ۰: تم (DarkTheme یا LightTheme) – در App.xaml.cs جابه‌جا می‌شود -->
                <ResourceDictionary Source="Resources/Themes/DarkTheme.xaml"/>
                <!-- ایندکس ۱: استایل‌های کنترل‌ها (از DynamicResource استفاده می‌کند) -->
                <ResourceDictionary Source="Resources/Themes/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
