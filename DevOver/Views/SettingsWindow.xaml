<Window x:Class="DevOver.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:DevOver.Helpers"
        Title="Langwich – تنظیمات"
        Width="420" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <StackPanel Margin="20">

        <!-- عنوان -->
        <TextBlock Text="Langwich"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}"
                   Margin="0,0,0,4"/>
        <TextBlock Text="تبدیل هوشمند چیدمان کیبورد فارسی ↔ انگلیسی"
                   FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,0,0,16"/>

        <!-- کارت میانبر -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="⌨  میانبر سراسری"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,8"/>

                <DockPanel>
                    <TextBlock Text="کلید فعلی:"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Right"
                               Margin="8,0,0,0"/>
                    <Button Content="{Binding HotkeyDisplayText}"
                            Command="{Binding StartListeningForHotkeyCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="140"
                            HorizontalAlignment="Left"/>
                </DockPanel>

                <!-- راهنمای ضبط کلید -->
                <TextBlock Text="🎯 حالا کلید مورد نظر را بفشارید..."
                           FontSize="11"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,6,0,0"
                           Visibility="{Binding IsListeningForHotkey, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>

        <!-- کارت گزینه‌ها -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="⚙  گزینه‌ها"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,10"/>

                <CheckBox Content="اجرای خودکار با ویندوز"
                          IsChecked="{Binding StartWithWindows}"
                          Margin="0,0,0,8"/>

                <CheckBox Content="نمایش اعلان بعد از تبدیل"
                          IsChecked="{Binding NotificationsEnabled}"
                          Margin="0,0,0,8"/>

                <CheckBox Content="تم تاریک"
                          IsChecked="{Binding IsDarkTheme}"/>
            </StackPanel>
        </Border>

        <!-- دکمه‌های ذخیره / لغو -->
        <DockPanel Margin="0,8,0,0">
            <Button Content="لغو"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    DockPanel.Dock="Left"
                    Width="90"/>
            <Button Content="ذخیره"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right"/>
        </DockPanel>

        <!-- نسخه -->
        <TextBlock Text="نسخه ۱.۰.۰  •  ساخته‌شده با ♥ برای توسعه‌دهندگان ایرانی"
                   FontSize="10"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,14,0,0"/>
    </StackPanel>
</Window>
