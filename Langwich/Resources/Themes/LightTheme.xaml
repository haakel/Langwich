<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== تم روشن — Flat Design / Teal ===== -->
    <Color x:Key="WindowBackgroundColor">#FFF0FDFA</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="PrimaryTextColor">#FF134E4A</Color>
    <Color x:Key="SecondaryTextColor">#FF4B6B68</Color>
    <Color x:Key="AccentColor">#FF0D9488</Color>
    <Color x:Key="AccentHoverColor">#FF0F766E</Color>
    <Color x:Key="BorderColor">#FF99F6E4</Color>
    <Color x:Key="ButtonHoverColor">#FF0F766E</Color>
    <Color x:Key="SecondaryButtonBgColor">#FFE8F1F4</Color>
    <Color x:Key="CheckBoxBgColor">#FF0D9488</Color>
    <Color x:Key="SuccessColor">#FF0D9488</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush"    Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"      Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush"         Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"       Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush"              Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"         Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush"              Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush"         Color="{StaticResource ButtonHoverColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonBgBrush"   Color="{StaticResource SecondaryButtonBgColor}"/>
    <SolidColorBrush x:Key="CheckBoxBgBrush"          Color="{StaticResource CheckBoxBgColor}"/>

</ResourceDictionary>
