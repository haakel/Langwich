<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- رنگ‌های تم تاریک -->
    <Color x:Key="WindowBackgroundColor">#FF1E1E24</Color>
    <Color x:Key="CardBackgroundColor">#FF2A2A33</Color>
    <Color x:Key="PrimaryTextColor">#FFF2F2F2</Color>
    <Color x:Key="SecondaryTextColor">#FF9A9AB0</Color>
    <Color x:Key="AccentColor">#FF6C63FF</Color>
    <Color x:Key="BorderColor">#FF3A3A45</Color>
    <Color x:Key="ButtonHoverColor">#FF7C74FF</Color>
    <Color x:Key="SecondaryButtonBgColor">#FF35353F</Color>

    <!-- براش‌ها -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"    Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"      Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush"         Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"       Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush"              Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="BorderBrush"              Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush"         Color="{StaticResource ButtonHoverColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonBgBrush"   Color="{StaticResource SecondaryButtonBgColor}"/>

</ResourceDictionary>
