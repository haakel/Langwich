<Window x:Class="Langwich.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Langwich"
        Width="380" Height="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">

    <Border x:Name="RootBorder"
            Background="{DynamicResource WindowBackgroundBrush}"
            CornerRadius="20"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center" Margin="30">

            <!-- لوگو -->
            <Border x:Name="LogoBox"
                    Width="76" Height="76"
                    CornerRadius="20"
                    Background="{DynamicResource AccentBrush}"
                    HorizontalAlignment="Center">
                <TextBlock Text="ل" FontSize="42" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Langwich" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       HorizontalAlignment="Center" Margin="0,18,0,0"/>

            <TextBlock Text="تبدیل هوشمند چیدمان کیبورد فارسی ↔ انگلیسی"
                       FontSize="12.5"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>

            <!-- نوار پیشرفت -->
            <Border Height="4" CornerRadius="2" Margin="40,22,40,0"
                    Background="{DynamicResource SecondaryButtonBgBrush}">
                <Border x:Name="ProgressFill" Width="0"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="2"
                        HorizontalAlignment="Left">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,300,4"/>
                    </Border.Clip>
                </Border>
            </Border>

            <TextBlock x:Name="StatusText"
                       Text="در حال راه‌اندازی..."
                       FontSize="10.5"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>